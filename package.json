{
	"name": "dinner-ideas",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"prepare": "husky"
	},
