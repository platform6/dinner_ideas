# Local config for `supabase functions serve`. Copy to supabase/functions/.env (gitignored).
# There is NO ANTHROPIC_API_KEY here — Claude keys are per-household (Supabase Vault), set by
# a household owner on /settings. See supabase/functions/claude-proxy/README.md.

ANTHROPIC_MODEL=claude-sonnet-5
AI_DAILY_CALL_LIMIT=25
